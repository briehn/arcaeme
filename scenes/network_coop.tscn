[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/network_coop.gd" id="1_view"]
[ext_resource type="Script" path="res://scripts/network/network_coop_session.gd" id="2_session"]
[ext_resource type="Resource" path="res://resources/prototype/local_coop_encounter.tres" id="3_encounter"]
[ext_resource type="Script" path="res://scripts/ui/enemy_playtest_selector.gd" id="4_enemy_selector"]
[ext_resource type="Script" path="res://scripts/ui/pacing_variant_picker.gd" id="5_pacing_picker"]
[ext_resource type="Texture2D" path="res://resources/prototype/encounter_backdrop.tres" id="6_backdrop"]

[node name="NetworkCoop" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_view")

[node name="Session" type="Node" parent="."]
script = ExtResource("2_session")
encounter = ExtResource("3_encounter")
player_ids = Array[StringName]([&"Battle Mage 1", &"Battle Mage 2", &"Battle Mage 3", &"Battle Mage 4"])

[node name="PortalBackdrop" type="TextureRect" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
texture = ExtResource("6_backdrop")
expand_mode = 1

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="ConnectionMargin" type="MarginContainer" parent="Layout"]
layout_mode = 2
theme_override_constants/margin_left = 30
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 30

[node name="Connection" type="VBoxContainer" parent="Layout/ConnectionMargin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Controls" type="HFlowContainer" parent="Layout/ConnectionMargin/Connection"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 10
theme_override_constants/v_separation = 8

[node name="AddressControls" type="HBoxContainer" parent="Layout/ConnectionMargin/Connection/Controls"]
layout_mode = 2

[node name="Address" type="Label" parent="Layout/ConnectionMargin/Connection/Controls/AddressControls"]
layout_mode = 2
text = "127.0.0.1 · UDP port"

[node name="Port" type="SpinBox" parent="Layout/ConnectionMargin/Connection/Controls/AddressControls"]
unique_name_in_owner = true
layout_mode = 2
min_value = 1024.0
max_value = 65535.0

[node name="PartySizeControls" type="HBoxContainer" parent="Layout/ConnectionMargin/Connection/Controls"]
layout_mode = 2

[node name="PartySizeLabel" type="Label" parent="Layout/ConnectionMargin/Connection/Controls/PartySizeControls"]
layout_mode = 2
text = "Host party size"

[node name="PartySize" type="OptionButton" parent="Layout/ConnectionMargin/Connection/Controls/PartySizeControls"]
unique_name_in_owner = true
layout_mode = 2

[node name="ShortRun" type="CheckBox" parent="Layout/ConnectionMargin/Connection/Controls"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Host an opening encounter, personal card rewards, and a boss."
text = "Short Run (Prototype)"

[node name="SpellDrawing" type="CheckBox" parent="Layout/ConnectionMargin/Connection/Controls"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Host a party where regular cards require runes. Choose your drawing input in Prototype Tools before joining. The standalone status and modifier fixtures use test cards without runes."
text = "Spell Drawing (Prototype)"

[node name="EnemyVarietyRun" type="CheckBox" parent="Layout/ConnectionMargin/Connection/Controls"]
unique_name_in_owner = true
visible = false
layout_mode = 2
disabled = true
text = "Enemy Variety Run"

[node name="MultiEnemyRun" type="CheckBox" parent="Layout/ConnectionMargin/Connection/Controls"]
unique_name_in_owner = true
visible = false
layout_mode = 2
disabled = true
tooltip_text = "Play Two Slimes, Goblin + Treant, and the Citadel Warden with personal rewards between fights."
text = "Multi-Enemy Short Run"

[node name="MajorArcana" type="CheckBox" parent="Layout/ConnectionMargin/Connection/Controls"]
unique_name_in_owner = true
visible = false
layout_mode = 2
disabled = true
text = "Major Arcana (Prototype)"

[node name="PortalPrototype" type="CheckBox" parent="Layout/ConnectionMargin/Connection/Controls"]
unique_name_in_owner = true
visible = false
layout_mode = 2
disabled = true
text = "Portal Routes (Prototype)"

[node name="BattleMagePool" type="CheckBox" parent="Layout/ConnectionMargin/Connection/Controls"]
unique_name_in_owner = true
visible = false
layout_mode = 2
disabled = true
tooltip_text = "Offer an expanded Battle Mage reward pool to each Mage in this run."
text = "Expanded Battle Mage Rewards (Prototype)"

[node name="PacingControls" type="HBoxContainer" parent="Layout/ConnectionMargin/Connection/Controls"]
unique_name_in_owner = true
visible = false
layout_mode = 2

[node name="PacingLabel" type="Label" parent="Layout/ConnectionMargin/Connection/Controls/PacingControls"]
layout_mode = 2
text = "Pacing (Prototype)"

[node name="PacingVariant" type="OptionButton" parent="Layout/ConnectionMargin/Connection/Controls/PacingControls"]
unique_name_in_owner = true
layout_mode = 2
disabled = true
script = ExtResource("5_pacing_picker")

[node name="StatusPlaytest" type="CheckBox" parent="Layout/ConnectionMargin/Connection/Controls"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Use provisional status cards and attack effects in the standalone encounter."
text = "Poison & Burning (Prototype)"

[node name="ModifierPlaytest" type="CheckBox" parent="Layout/ConnectionMargin/Connection/Controls"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Use the provisional Strength and Dexterity cards in the standalone encounter."
text = "Strength & Dexterity (Prototype)"

[node name="EnemyPlaytest" type="OptionButton" parent="Layout/ConnectionMargin/Connection/Controls"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Choose a provisional enemy for the standalone encounter."
script = ExtResource("4_enemy_selector")
include_default = true

[node name="CardExpansion" type="CheckBox" parent="Layout/ConnectionMargin/Connection/Controls"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Use the expanded test deck for this standalone encounter or Enemy Variety Run."
text = "Card Expansion Deck (Prototype)"

[node name="HostButton" type="Button" parent="Layout/ConnectionMargin/Connection/Controls"]
unique_name_in_owner = true
layout_mode = 2
text = "Host Encounter"

[node name="JoinButton" type="Button" parent="Layout/ConnectionMargin/Connection/Controls"]
unique_name_in_owner = true
layout_mode = 2
text = "Join Encounter"

[node name="SessionInfo" type="HBoxContainer" parent="Layout/ConnectionMargin/Connection"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="SessionText" type="VBoxContainer" parent="Layout/ConnectionMargin/Connection/SessionInfo"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="ConnectionStatus" type="Label" parent="Layout/ConnectionMargin/Connection/SessionInfo/SessionText"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 3

[node name="PartyRoster" type="Label" parent="Layout/ConnectionMargin/Connection/SessionInfo/SessionText"]
unique_name_in_owner = true
visible = false
layout_mode = 2
autowrap_mode = 3

[node name="LeaveButton" type="Button" parent="Layout/ConnectionMargin/Connection/SessionInfo"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 0
text = "Back to Menu"

[node name="RunStage" type="Label" parent="Layout/ConnectionMargin/Connection"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_font_sizes/font_size = 20
autowrap_mode = 3

[node name="RewardPanel" type="MarginContainer" parent="Layout"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/margin_left = 30
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 30
theme_override_constants/margin_bottom = 20

[node name="RewardLayout" type="VBoxContainer" parent="Layout/RewardPanel"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="RewardStatus" type="Label" parent="Layout/RewardPanel/RewardLayout"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 3

[node name="RewardProgress" type="Label" parent="Layout/RewardPanel/RewardLayout"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 3

[node name="RewardScroll" type="ScrollContainer" parent="Layout/RewardPanel/RewardLayout"]
layout_mode = 2
size_flags_vertical = 3
follow_focus = true
horizontal_scroll_mode = 0

[node name="RewardChoices" type="BoxContainer" parent="Layout/RewardPanel/RewardLayout/RewardScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8
vertical = true

[node name="SkipReward" type="Button" parent="Layout/RewardPanel/RewardLayout"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 0
text = "Skip Reward"

[node name="CombatSlot" type="Control" parent="Layout"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_vertical = 3

[connection signal="pressed" from="Layout/ConnectionMargin/Connection/Controls/HostButton" to="." method="_on_host_pressed"]
[connection signal="pressed" from="Layout/ConnectionMargin/Connection/Controls/JoinButton" to="." method="_on_join_pressed"]
[connection signal="pressed" from="Layout/ConnectionMargin/Connection/SessionInfo/LeaveButton" to="." method="_on_leave_pressed"]
[connection signal="pressed" from="Layout/RewardPanel/RewardLayout/SkipReward" to="." method="_on_skip_reward_pressed"]
