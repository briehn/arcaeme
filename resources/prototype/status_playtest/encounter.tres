[gd_resource type="Resource" format=3]

[ext_resource type="Script" path="res://scripts/combat/encounter_data.gd" id="1_encounter"]
[ext_resource type="Script" path="res://scripts/combat/card_data.gd" id="2_card"]
[ext_resource type="Script" path="res://scripts/combat/card_effect.gd" id="3_effect"]
[ext_resource type="Resource" path="res://resources/prototype/cards/basic_strike.tres" id="4_strike"]
[ext_resource type="Resource" path="res://resources/prototype/cards/basic_block.tres" id="5_block"]
[ext_resource type="Resource" path="res://resources/prototype/cards/arcane_guard.tres" id="6_guard"]

[sub_resource type="Resource" id="PoisonEffect"]
script = ExtResource("3_effect")
kind = 4
amount = 4

[sub_resource type="Resource" id="PoisonCard"]
script = ExtResource("2_card")
id = &"status_test_poison"
display_name = "Test Toxic Spark"
mana_cost = 1
approval_status = "Provisional test card"
effects = Array[ExtResource("3_effect")]([SubResource("PoisonEffect")])

[sub_resource type="Resource" id="BurningEffect"]
script = ExtResource("3_effect")
kind = 5
amount = 5

[sub_resource type="Resource" id="BurningCard"]
script = ExtResource("2_card")
id = &"status_test_burning"
display_name = "Test Ember Spark"
mana_cost = 1
approval_status = "Provisional test card"
effects = Array[ExtResource("3_effect")]([SubResource("BurningEffect")])

[resource]
script = ExtResource("1_encounter")
player_max_hp = 36
enemy_id = &"training_golem"
enemy_name = "Training Golem"
enemy_max_hp = 34
enemy_attack = 9
shuffle_seed = 104774
test_deck = Array[ExtResource("2_card")]([SubResource("PoisonCard"), SubResource("BurningCard"), ExtResource("6_guard"), ExtResource("4_strike"), ExtResource("5_block")])
enemy_poison_per_attack = 2
enemy_burning_per_attack = 3
