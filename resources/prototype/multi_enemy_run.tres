starting_deck = Array[ExtResource("3_card")]([ExtResource("strike"), ExtResource("strike"), ExtResource("strike"), ExtResource("strike"), ExtResource("strike"), ExtResource("block"), ExtResource("block"), ExtResource("block"), ExtResource("block"), ExtResource("guard"), ExtResource("prep")])
