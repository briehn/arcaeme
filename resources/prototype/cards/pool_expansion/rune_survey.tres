[gd_resource type="Resource" format=3]

[ext_resource type="Script" path="res://scripts/combat/card_data.gd" id="1_card"]
[ext_resource type="Script" path="res://scripts/combat/card_effect.gd" id="2_effect"]
[ext_resource type="Resource" path="res://resources/prototype/spell_drawing/rune_survey.tres" id="3_rune"]

[sub_resource type="Resource" id="Effect_1"]
script = ExtResource("2_effect")
