[gd_resource type="Resource" format=3]

[ext_resource type="Script" path="res://scripts/combat/spell_drawing_settings.gd" id="1_settings"]
[ext_resource type="Script" path="res://scripts/combat/card_data.gd" id="2_card"]
[ext_resource type="Resource" path="res://resources/prototype/cards/basic_strike.tres" id="strike"]
[ext_resource type="Resource" path="res://resources/prototype/cards/basic_block.tres" id="block"]
[ext_resource type="Resource" path="res://resources/prototype/cards/expansion/astral_salvo.tres" id="salvo"]
[ext_resource type="Resource" path="res://resources/prototype/cards/spell_ink_booster.tres" id="booster"]
[ext_resource type="Resource" path="res://resources/prototype/cards/battle_preparation.tres" id="preparation"]

[resource]
script = ExtResource("1_settings")
test_deck = Array[ExtResource("2_card")]([ExtResource("strike"), ExtResource("block"), ExtResource("salvo"), ExtResource("booster"), ExtResource("preparation")])
